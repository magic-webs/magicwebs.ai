# Convex — written by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ---------------------------------------------------------------------------
# Owner panel (/owner)
# ---------------------------------------------------------------------------

# The password typed at /owner/login. There is one operator and no user table,
# so this single value is the whole login. Make it long and random.
OWNER_PASSWORD=

# HMAC key that signs the owner session cookie. Any long random string;
# changing it signs everyone out immediately.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OWNER_SESSION_SECRET=

# Bearer token the Next.js server sends to the owner-only Convex functions.
# It MUST equal OWNER_API_TOKEN on the Convex deployment:
#   npx convex env set OWNER_API_TOKEN <same value>
# Never expose this to the browser — it reads every enquiry.
CONVEX_OWNER_TOKEN=

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------

# Google Search Console verification token. In Search Console pick the URL-prefix
# property for https://magicwebs.ai, choose the "HTML tag" method, and paste only
# the content="..." value here (not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=
